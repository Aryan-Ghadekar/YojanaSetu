# Supabase project settings (Project Settings -> API in the Supabase dashboard)
SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
# Service role key - server-side only, NEVER expose this to the frontend.
SUPABASE_SERVICE_ROLE_KEY="YOUR_SERVICE_ROLE_KEY"

# Storage bucket used for uploaded citizen documents (create it in Supabase Storage).
SUPABASE_DOCUMENTS_BUCKET="documents"

# Port the Express API listens on.
PORT=4000

# Comma-separated list of origins allowed to call this API (your Vite dev server / deployed frontend).
CLIENT_ORIGIN="http://localhost:3000"

# Document OCR + field extraction (Python service in ./ocr-service, see its README).
# Leave OCR_SERVICE_URL empty to skip OCR; uploads are then stored as "Unable to Verify".
OCR_SERVICE_URL="http://127.0.0.1:8001"
# Must match OCR_SERVICE_TOKEN in ocr-service/.env.
OCR_SERVICE_TOKEN=""
# First request loads the OCR models, so allow a generous timeout (ms).
OCR_TIMEOUT_MS=120000
