# Google AI Studio key (https://aistudio.google.com/apikey) - required for field extraction.
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"

# "en" or "hi" (Hindi/Devanagari is the closest model to Marathi).
OCR_LANG="en"
MAX_UPLOAD_MB=15

# Must match OCR_SERVICE_TOKEN in the Express server's .env.
OCR_SERVICE_TOKEN=""
